# Switchboard environment. Copy to .env at the repo root and fill in. Never commit .env.
# Every integration falls back to a dry-run / fixture mode when its key is blank,
# so the server, dashboard and mock demo run with this file copied unchanged.

# ---------------------------------------------------------------- server (P2)
# FastAPI / uvicorn port. The Vite dev server proxies /api and /events to it.
PORT=8787
DATABASE_PATH=./data/switchboard.sqlite
# Public HTTPS address of this server (tunnel). Needed only for real webhooks and calls.
PUBLIC_BASE_URL=

# ---------------------------------------------------------- real-money guards
# Hard switches. Leave exactly as they are unless you mean it.
TRADING_ENABLED=false
MAX_ORDER_USD=2

# -------------------------------------------------- P1 stubs vs. real routers
# true  = /api/chain and /api/markets answer from server/fixtures (no chain, no venues)
# false = mount P1's real routers from server/app/chain and server/app/markets
USE_P1_STUBS=true

# ------------------------------------------------------- demo policy defaults
# Mirrors the vault policy so the planner can predict pay / ask / block.
# The contract stays the authority once P1's vault is wired in.
POLICY_TRANSFER_CAP_USD=200
POLICY_DAILY_BUDGET_USD=500
# Above this amount an approval also needs a passkey confirmation on the dashboard.
PASSKEY_THRESHOLD_USD=1000
# Seconds before an unanswered approval request resolves as denied.
APPROVAL_EXPIRY_S=300
# Anti-rubber-stamping: maximum approval calls placed per day.
MAX_CALLS_PER_DAY=5

# ------------------------------------------------------ intent parser LLM (P2)
# One structured-output call, no tools, never sees external content.
# Blank key = deterministic rule-based parser (good enough for the demo sentences).
ANTHROPIC_API_KEY=
INTENT_MODEL=claude-opus-5-5

# -------------------------------------------------- forecast opinion LLMs (P2)
# Needs at least three models from different families. Either set OPENROUTER_API_KEY
# (one key, all families) or set the individual provider keys you have.
# Fewer than three usable models = forecast is reported as "unavailable", never faked.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
# Comma-separated model ids, one per family. Blank = built-in defaults.
FORECAST_MODELS=

# ------------------------------------------------------------ ElevenLabs (P2)
# Used without any phone line for the dashboard: speech-to-text for the microphone and
# text-to-speech for the quote read back. Blank = the browser's own speech is used.
ELEVENLABS_API_KEY=
# The ElevenLabs agent: needed only for CALL_PROVIDER=elevenlabs_twilio and for the browser
# widget fallback. Filled in by `scripts.create_agent --apply --write-env`.
ELEVENLABS_AGENT_ID=
# Id of the Twilio number imported into ElevenLabs. Only for CALL_PROVIDER=elevenlabs_twilio.
ELEVENLABS_PHONE_NUMBER_ID=
# Secret for verifying ElevenLabs post-call webhooks (missed call / no answer).
ELEVENLABS_WEBHOOK_SECRET=
# Voices for the two personas (ElevenLabs voice ids). Blank = agent defaults.
ELEVENLABS_OPERATOR_VOICE_ID=
ELEVENLABS_RISK_OFFICER_VOICE_ID=

# ------------------------------------------------------------ AgentPhone (P2)
# The approval call when CALL_PROVIDER=agentphone. The key is sent only to api.agentphone.ai.
AGENTPHONE_API_KEY=
# Both ids are looked up and saved by `uv run python -m scripts.agentphone_setup --write-env`.
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
# Signing secret for /api/voice/hooks/agentphone. Saved by
# `uv run python -m scripts.agentphone_setup --register-webhook` (needs PUBLIC_BASE_URL).
AGENTPHONE_WEBHOOK_SECRET=

# ------------------------------------------------------------ phone calls (P2)
# Who places the approval call: dry_run (no call), agentphone, or elevenlabs_twilio.
CALL_PROVIDER=dry_run
# The only number approval calls may go to, in E.164 form (+16045550123).
OWNER_PHONE_NUMBER=
# false = log the outbound-call request instead of placing it, whatever CALL_PROVIDER says.
CALLS_ENABLED=false
# Bearer token the ElevenLabs agent sends when calling /api/voice/* tools.
VOICE_TOKEN=

# ------------------------------------------------------------- Grok Bots (P2)
# Bearer token Grok Bot routines send when calling /api/bots/* routes.
BOT_TOKEN=
# Webhook URL of the "missed-call escalation" routine (from the Grok Bot UI).
GROK_MISSED_CALL_WEBHOOK_URL=

# ------------------------------------------------- P1: chain (fill in by P1)
ARC_RPC_URL=https://rpc.testnet.arc.io
VAULT_ADDRESS=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
QUICKNODE_STREAM_SECRET=

# ----------------------------------------------- P1: markets (fill in by P1)
# Trading permission only. Never a key that can withdraw.
GEMINI_API_KEY=
GEMINI_API_SECRET=
POLYMARKET_ACCESS_KEY=
POLYMARKET_PRIVATE_KEY=
